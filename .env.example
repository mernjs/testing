# ---------------------------------------------------------------------------
# YashOrbit — environment variables
# Copy to `.env` and fill in. `.env*` is gitignored.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas). Database name is taken from the URI path.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/yashorbit"

# ---------------------------------------------------------------------------
# AI Chatbot (YashOrbit AI Assistant)
# ---------------------------------------------------------------------------

# OpenAI API key — powers the RAG chatbot (Responses API + file_search +
# hosted vector stores). Server-only; never exposed to the browser. REQUIRED
# for the chatbot to function.
OPENAI_API_KEY=""

# Optional. The OpenAI Vector Store that holds the knowledge base. If unset,
# one is created automatically on the first index run and its id is persisted
# into the `ai_chatbot_config` document — you do not normally need to set this.
OPENAI_CHATBOT_VECTOR_STORE_ID=""

# Optional. Base URL the knowledge-base crawler fetches public pages from.
# Defaults to the request origin, falling back to the production site URL.
# Set this when indexing from a machine that can't reach the public domain
# (e.g. local dev: "http://localhost:3000").
CHATBOT_CRAWL_BASE_URL=""

# Optional. Bearer secret to allow triggering a knowledge-base re-index via
# `POST /api/admin/chatbot/reindex` without an admin session (for cron / CI).
CHATBOT_ADMIN_API_SECRET=""

# ---------------------------------------------------------------------------
# Existing integrations
# ---------------------------------------------------------------------------

# Optional bearer secret for admin lead/PII API endpoints and CSV exports.
LEADS_API_SECRET=""

# Optional bearer secret for the Google Indexing notification endpoint.
INDEXING_API_SECRET=""

# Google Search Console site verification token (public).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
